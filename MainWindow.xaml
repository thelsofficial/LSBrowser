<Window x:Class="LSBROWSER_CLEAN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LS Browser"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#FF050509">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>   <!-- Top bar -->
            <RowDefinition Height="*"/>    <!-- Content area -->
        </Grid.RowDefinitions>

        <!-- TOP GLASS BAR (BLURRED BACKGROUND + CRISP UI) -->
        <Grid Grid.Row="0" ClipToBounds="True">

            <!-- Blurred background -->
            <Border Background="#20FFFFFF"
                    BorderBrush="#40FFFFFF"
                    BorderThickness="0,0,0,1"
                    Panel.ZIndex="0">
                <Border.Effect>
                    <BlurEffect Radius="18"/>
                </Border.Effect>
            </Border>

            <!-- Crisp UI -->
            <Grid Margin="12,8"
                  Panel.ZIndex="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LS RIBBON + TITLE -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Grid.Column="0"
                            Margin="0,0,16,0">

                    <!-- Ribbon shape -->
                    <Grid Width="28" Height="28">
                        <Border CornerRadius="10"
                                Background="#FF1E1E2A">
                            <Border.Effect>
                                <BlurEffect Radius="10"/>
                            </Border.Effect>
                        </Border>
                        <Border CornerRadius="10"
                                Margin="3"
                                Background="#FF111118"/>
                        <Border CornerRadius="10"
                                Margin="5,4,7,6">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FFE7C56F" Offset="0.0"/>
                                    <GradientStop Color="#FF4FD1C5" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>

                    <TextBlock Text="LS Browser"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#F0FFFFFF"
                               FontSize="16"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <!-- ADDRESS BAR -->
                <Border Grid.Column="1"
                        Background="#30FFFFFF"
                        CornerRadius="18"
                        BorderBrush="#55FFFFFF"
                        BorderThickness="1"
                        Padding="6"
                        Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BackButton"
                                Content="←"
                                Width="28"
                                Height="28"
                                Margin="2"
                                Background="#20FFFFFF"
                                Foreground="White"
                                BorderThickness="0"/>

                        <Button x:Name="ForwardButton"
                                Content="→"
                                Width="28"
                                Height="28"
                                Margin="2"
                                Grid.Column="1"
                                Background="#20FFFFFF"
                                Foreground="White"
                                BorderThickness="0"/>

                        <Button x:Name="ReloadButton"
                                Content="⟳"
                                Width="28"
                                Height="28"
                                Margin="2"
                                Grid.Column="2"
                                Background="#20FFFFFF"
                                Foreground="White"
                                BorderThickness="0"/>

                        <Border Grid.Column="3"
                                Background="#20FFFFFF"
                                CornerRadius="14"
                                BorderBrush="#40FFFFFF"
                                BorderThickness="1"
                                Margin="6,0"
                                Padding="2">
                            <TextBox x:Name="AddressBar"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="White"
                                     FontSize="14"
                                     VerticalContentAlignment="Center"
                                     Text="https://"
                                     Padding="4,0"/>
                        </Border>

                        <Button x:Name="GoButton"
                                Content="Go"
                                Width="40"
                                Height="28"
                                Margin="2"
                                Grid.Column="4"
                                Background="#30E7C56F"
                                Foreground="White"
                                BorderThickness="0"/>
                    </Grid>
                </Border>

                <!-- SHIFT AI PILL -->
                <Border Grid.Column="2"
                        CornerRadius="18"
                        Padding="10,6"
                        Cursor="Hand"
                        Background="#40E7C56F"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        x:Name="ShiftAIPill">
                    <Border.Effect>
                        <BlurEffect Radius="12"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="#FFE7C56F" Margin="0,0,6,0"/>
                        <TextBlock Text="ShiftAI"
                                   Foreground="#FF0B0B0F"
                                   FontWeight="SemiBold"
                                   FontSize="13"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- CONTENT AREA -->
        <Grid Grid.Row="1">

            <!-- FLOATING TAB BAR (C2) -->
            <Grid Height="56"
                  VerticalAlignment="Top"
                  Margin="0,16,0,0"
                  ClipToBounds="True">

                <!-- Floating blurred bar -->
                <Border Background="#20FFFFFF"
                        CornerRadius="14"
                        Margin="24,0,24,0"
                        Panel.ZIndex="0">
                    <Border.Effect>
                        <BlurEffect Radius="18"/>
                    </Border.Effect>
                </Border>

                <!-- Crisp tabs -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="36,0"
                            Panel.ZIndex="10">

                    <!-- Active tab -->
                    <Border CornerRadius="12"
                            Background="#40FFFFFF"
                            BorderBrush="#80FFFFFF"
                            BorderThickness="1"
                            Padding="14,6"
                            Margin="0,0,12,0">
                        <TextBlock Text="Tab 1"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <!-- Inactive tab -->
                    <Border CornerRadius="12"
                            Background="#15FFFFFF"
                            BorderBrush="#40FFFFFF"
                            BorderThickness="1"
                            Padding="14,6"
                            Margin="0,0,12,0">
                        <TextBlock Text="Tab 2"
                                   Foreground="#AAFFFFFF"
                                   FontSize="14"/>
                    </Border>

                </StackPanel>
            </Grid>

            <!-- MAIN BROWSER AREA -->
            <Grid Margin="0,72,0,0">

                <!-- MINIMAL LAYOUT -->
                <Grid x:Name="MinimalLayout" Visibility="Collapsed">
                    <Grid x:Name="BrowserRoot_Minimal">

                        <Grid x:Name="HomepageHost_Minimal"
                              Background="#FF050509"
                              Visibility="Visible">

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Width="480">

                                <TextBlock Text="Welcome to LS Browser"
                                           Foreground="White"
                                           FontSize="26"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,16"/>

                                <TextBlock Text="Describe where you want to go, or enter a URL."
                                           Foreground="#AAFFFFFF"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,16"/>

                                <Border CornerRadius="18"
                                        Background="#20FFFFFF"
                                        BorderBrush="#40FFFFFF"
                                        BorderThickness="1"
                                        Padding="8">
                                    <TextBox x:Name="HomepageSearch_Minimal"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="White"
                                             FontSize="14"
                                             VerticalContentAlignment="Center"
                                             Text="https://"
                                             Padding="4,0"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="BrowserSurface_Minimal"
                              Background="Black"/>
                    </Grid>
                </Grid>

                <!-- SIDEBAR LAYOUT -->
                <Grid x:Name="SidebarLayout" Visibility="Visible">
                    <DockPanel>

                        <StackPanel Width="72"
                                    Background="#FF0B0B10"
                                    DockPanel.Dock="Left">

                            <Button x:Name="SidebarHome"
                                    Content="⌂"
                                    Width="40"
                                    Height="40"
                                    Margin="16,16,16,8"
                                    Background="#20FFFFFF"
                                    Foreground="White"
                                    BorderThickness="0"/>

                            <Button x:Name="SidebarTabs"
                                    Content="≡"
                                    Width="40"
                                    Height="40"
                                    Margin="16,0"
                                    Background="#10FFFFFF"
                                    Foreground="White"
                                    BorderThickness="0"/>

                            <Button x:Name="SidebarHistory"
                                    Content="⏱"
                                    Width="40"
                                    Height="40"
                                    Margin="16,8"
                                    Background="#10FFFFFF"
                                    Foreground="White"
                                    BorderThickness="0"/>

                            <Button x:Name="SidebarShiftAI"
                                    Content="◎"
                                    Width="40"
                                    Height="40"
                                    Margin="16,8"
                                    Background="#10FFFFFF"
                                    Foreground="White"
                                    BorderThickness="0"/>

                            <Button x:Name="SidebarSettings"
                                    Content="⚙"
                                    Width="40"
                                    Height="40"
                                    Margin="16,8"
                                    Background="#10FFFFFF"
                                    Foreground="White"
                                    BorderThickness="0"/>
                        </StackPanel>

                        <Grid Background="#FF050509">
                            <Grid x:Name="BrowserRoot_Sidebar">

                                <Grid x:Name="HomepageHost_Sidebar"
                                      Background="#FF050509"
                                      Visibility="Visible">

                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Width="480">

                                        <TextBlock Text="Welcome to LS Browser"
                                                   Foreground="White"
                                                   FontSize="26"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,16"/>

                                        <TextBlock Text="Start with a thought, a place, or a URL."
                                                   Foreground="#AAFFFFFF"
                                                   FontSize="14"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,16"/>

                                        <Border CornerRadius="18"
                                                Background="#20FFFFFF"
                                                BorderBrush="#40FFFFFF"
                                                BorderThickness="1"
                                                Padding="8">
                                            <TextBox x:Name="HomepageSearch_Sidebar"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Foreground="White"
                                                     FontSize="14"
                                                     VerticalContentAlignment="Center"
                                                     Text="https://"
                                                     Padding="4,0"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <Grid x:Name="BrowserSurface_Sidebar"
                                      Background="Black"/>
                            </Grid>
                        </Grid>

                    </DockPanel>
                </Grid>

                <!-- SHIFT AI PANEL -->
                <Border x:Name="ShiftAIPanel"
                        Background="#B0000000"
                        Visibility="Collapsed">
                    <Grid HorizontalAlignment="Right"
                          Width="360"
                          Background="#F015151C">
                        <Grid.Effect>
                            <BlurEffect Radius="18"/>
                        </Grid.Effect>

                        <StackPanel Margin="16">
                            <TextBlock Text="ShiftAI"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="This is your LS intelligence side panel."
                                       Foreground="#CCFFFFFF"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>

                            <Border CornerRadius="12"
                                    Background="#20FFFFFF"
                                    BorderBrush="#40FFFFFF"
                                    BorderThickness="1"
                                    Padding="8">
                                <TextBlock Text="(Placeholder content.)"
                                           Foreground="#DDFFFFFF"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>

        </Grid>

        <!-- WINDOW CONTROLS -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,4,4,0">
            <Button Content="—"
                    Width="28"
                    Height="24"
                    Margin="0,0,2,0"
                    Click="MinimizeWindow"
                    Background="#10FFFFFF"
                    Foreground="White"
                    BorderThickness="0"/>
            <Button Content="✕"
                    Width="28"
                    Height="24"
                    Click="CloseWindow"
                    Background="#20FFFFFF"
                    Foreground="White"
                    BorderThickness="0"/>
        </StackPanel>

    </Grid>
</Window>
